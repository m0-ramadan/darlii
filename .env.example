APP_NAME="Homzen Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=homzen_laravel
DB_USERNAME=homzen
DB_PASSWORD=homzen_secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

DEFAULT_CURRENCY=EGP
LEGACY_IMPORT_ENABLED=true

# Keep the uploaded Homzen frontend pixel-compatible
LEGACY_FRONTEND_EXACT=true

# Browser key; restrict it to your domains and the Maps JavaScript API in Google Cloud.
GOOGLE_MAPS_API_KEY=
