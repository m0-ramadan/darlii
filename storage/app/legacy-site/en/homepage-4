  <meta name="description" content="Your dream home .. closer than you imagine - Darlii Real Estate Platform">
  <link rel="shortcut icon" href="/themes/homzen/images/logo/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
