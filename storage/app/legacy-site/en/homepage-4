<body class="body" id="page-home" dir="ltr">
  <div id="wrapper">

    <!-- TOPBAR -->
    <div class="darli-topbar">
      <div class="darli-container darli-topbar-inner">
        <div class="darli-topbar-right" style="display: flex; align-items: center; gap: 20px;">
          <span class="darli-topbar-item">
            <i data-lucide="map-pin" style="width: 15px; height: 15px; color: var(--darli-gold);"></i>
            <span>Egypt</span>
            <i data-lucide="chevron-down" style="width: 13px; height: 13px;"></i>
          </span>
          <a href="/language/switch/ar" class="darli-topbar-item">
            <i data-lucide="globe" style="width: 15px; height: 15px; color: var(--darli-gold);"></i>
            <span>العربية</span>
            <i data-lucide="chevron-down" style="width: 13px; height: 13px;"></i>
          </a>
        </div>
        <div class="darli-topbar-left" style="display: flex; align-items: center; gap: 18px;">
          <a href="/en/wishlist" class="darli-topbar-item">
            <i data-lucide="heart" style="width: 15px; height: 15px;"></i>
            <span>Wishlist</span>
          </a>
          <a href="/en/login" class="darli-topbar-item">
            <i data-lucide="log-in" style="width: 15px; height: 15px;"></i>
            <span>Login</span>
          </a>
          <button class="darli-theme-toggle" id="theme-toggle-btn" type="button" aria-label="Toggle theme">
            <i data-lucide="moon" class="theme-icon-moon"></i>
            <i data-lucide="sun" class="theme-icon-sun"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN NAVIGATION BAR -->
    <header class="darli-navbar">
      <div class="darli-container darli-navbar-inner">
        <!-- LOGO -->
        <a href="/en" class="darli-logo-wrapper">
          <img src="/themes/homzen/images/logo/darli-logo-en.png" alt="Darlii - Your Place Starts Here"
            class="darli-logo-img"
            onerror="this.onerror=null;this.src='/themes/homzen/images/darli-placeholder-en.png';">
        </a>

        <!-- NAV MENU -->
        <nav>
          <ul class="darli-nav-menu">
            <li class="active"><a href="/en">Home</a></li>
            <li><a href="/en/properties">Properties</a></li>
            <li><a href="/en/projects">Projects</a></li>
            <li><a href="/en/properties?view=city">Cities</a></li>
            <li><a href="/en/agents">Agents</a></li>
          </ul>
        </nav>

        <!-- CTA BUTTON -->
        <div>
          <a href="/en/dashboard/properties/create" class="darli-btn-add-property">
            <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
            <span>Add Property</span>
          </a>
        </div>
      </div>
    </header>

    <!-- =========================================================================
       1. HERO SECTION WITH CAIRO MAP & FLOATING FILTER
       ========================================================================= -->
    <section class="darli-hero-section">
      <!-- Location Pins on Hero Map Background -->
      <div class="darli-map-pin pin-zayed">Sheikh Zayed</div>
      <div class="darli-map-pin pin-october">6th of October</div>
      <div class="darli-map-pin pin-cairo">Cairo</div>
      <div class="darli-map-pin pin-nasr-city">Nasr City</div>
      <div class="darli-map-pin pin-tagamoa">New Cairo</div>
      <a href="/en/properties?location=Sheikh Zayed" class="darli-map-pin pin-zayed">
        <i data-lucide="map-pin" class="pin-gold-icon"></i>
        <span>Sheikh Zayed</span>
      </a>
      <a href="/en/properties?location=6th of October" class="darli-map-pin pin-october">
        <i data-lucide="map-pin" class="pin-gold-icon"></i>
        <span>6th of October</span>
      </a>
      <a href="/en/properties?location=Nasr City" class="darli-map-pin pin-nasr-city">
        <i data-lucide="map-pin" class="pin-gold-icon"></i>
        <span>Nasr City</span>
      </a>
      <a href="/en/properties?location=New Cairo" class="darli-map-pin pin-tagamoa">
        <i data-lucide="map-pin" class="pin-gold-icon"></i>
        <span>New Cairo</span>
      </a>

      <div class="darli-container">
        <div class="darli-hero-content">
          <h1 class="darli-hero-title">
            Discover the Best Properties<br>Across Darlii
          </h1>
          <p class="darli-hero-subtitle">Your dream home .. closer than you imagine</p>
          <a href="/en/properties" class="darli-btn-map-view">
            <i data-lucide="map" style="width: 18px; height: 18px;"></i>
            <i data-lucide="map" class="btn-map-icon"></i>
            <span>Explore Map</span>
            <i data-lucide="arrow-right" class="btn-arrow-icon"></i>
          </a>
        </div>

        <!-- Floating Filter Search Box (Exact Screenshot 1 Design) -->
        <div class="darli-search-card">
          <form action="/en/properties" method="GET" class="darli-search-form" id="darli-hero-search-form">
            <div class="darli-search-main-row" style="display: flex; align-items: flex-end; gap: 14px; width: 100%;">
              <!-- 1. Keyword -->
              <div class="darli-filter-field darli-field-keyword">
                <label class="darli-field-label">
                  <i data-lucide="search" class="label-gold-icon"></i>
                  <span>Keyword</span>
                </label>
                <div class="darli-input-wrapper">
                  <input type="text" name="k" class="darli-filter-input" placeholder="Search by keyword">
                  <i data-lucide="search" class="input-inner-icon"></i>
                </div>
              </div>

              <!-- 2. Location -->
              <div class="darli-filter-field darli-field-location">
                <label class="darli-field-label">
                  <i data-lucide="map-pin" class="label-gold-icon"></i>
                  <span>Location</span>
                </label>
                <div class="darli-input-wrapper">
                  <input type="text" name="location" class="darli-filter-input" placeholder="Search by location">
                  <i data-lucide="crosshair" class="input-inner-icon"></i>
                </div>
              </div>

              <!-- 3. Category -->
              <div class="darli-filter-field darli-field-category">
                <label class="darli-field-label">
                  <i data-lucide="layers" class="label-gold-icon"></i>
                  <span>Category</span>
                </label>
                <div class="darli-select-wrapper">
                  <select name="category_id" class="darli-filter-select">
                    <option value="">All</option>
                    <option value="1">Apartment</option>
                    <option value="2">Villa</option>
                    <option value="3">Condo</option>
                    <option value="4">House</option>
                    <option value="5">Land</option>
                    <option value="6">Commercial property</option>
                  </select>
                </div>
              </div>

              <!-- 4. Advanced -->
              <div class="darli-btn-advanced-wrapper">
                <button type="button" class="darli-btn-advanced" id="darli-toggle-advanced" aria-expanded="false"
                  aria-controls="darli-advanced-panel">
                  <i data-lucide="sliders-horizontal" style="width: 17px; height: 17px; color: #E5B158;"></i>
                  <span>Advanced</span>
                </button>
              </div>

              <!-- 5. Search -->
              <div>
                <button type="submit" class="darli-btn-search">
                  <i data-lucide="search" style="width: 18px; height: 18px;"></i>
                  <span>Search</span>
                </button>
              </div>
            </div>

            <!-- Advanced Filters Collapsible Panel -->
            <div class="darli-advanced-filter-panel" id="darli-advanced-panel">
              <div class="darli-adv-grid">
                <!-- Type: Sale / Rent -->
                <div class="darli-adv-field">
                  <label class="darli-adv-label">Property Type</label>
                  <select name="type" class="darli-adv-select">
                    <option value="">All (For Sale & For Rent)</option>
                    <option value="sale">For Sale</option>
                    <option value="rent">For Rent</option>
                  </select>
                </div>

                <!-- Min Price -->
                <div class="darli-adv-field">
                  <label class="darli-adv-label">Min Price (EGP)</label>
                  <input type="number" name="min_price" class="darli-adv-input" placeholder="0" min="0" step="10000">
                </div>

                <!-- Max Price -->
                <div class="darli-adv-field">
                  <label class="darli-adv-label">Max Price (EGP)</label>
                  <input type="number" name="max_price" class="darli-adv-input" placeholder="Any" min="0" step="10000">
                </div>

                <!-- Bedrooms -->
                <div class="darli-adv-field">
                  <label class="darli-adv-label">Bedrooms</label>
                  <select name="bedroom" class="darli-adv-select">
                    <option value="">Any</option>
                    <option value="1">1 Bed</option>
                    <option value="2">2 Beds</option>
                    <option value="3">3 Beds</option>
                    <option value="4">4 Beds</option>
                    <option value="5">5+ Beds</option>
                  </select>
                </div>

                <!-- Bathrooms -->
                <div class="darli-adv-field">
                  <label class="darli-adv-label">Bathrooms</label>
                  <select name="bathroom" class="darli-adv-select">
                    <option value="">Any</option>
                    <option value="1">1 Bath</option>
                    <option value="2">2 Baths</option>
                    <option value="3">3 Baths</option>
                    <option value="4">4+ Baths</option>
                  </select>
                </div>
              </div>

              <!-- Amenities / Features -->
              <div class="darli-adv-amenities-title">Amenities & Features:</div>
              <div class="darli-adv-amenities-grid">
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]"
                    value="1"><span>Wifi</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]"
                    value="2"><span>Parking</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]" value="3"><span>Swimming
                    pool</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]"
                    value="4"><span>Balcony</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]"
                    value="5"><span>Garden</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]"
                    value="6"><span>Security</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]" value="7"><span>Fitness
                    center</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]" value="8"><span>Air
                    Conditioning</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]" value="9"><span>Central
                    Heating</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]" value="10"><span>Laundry
                    Room</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]" value="11"><span>Pets
                    Allow</span></label>
                <label class="darli-adv-amenity-item"><input type="checkbox" name="features[]" value="12"><span>Spa &
                    Massage</span></label>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>

